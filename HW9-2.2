import numpy as np
import matplotlib.pyplot as plt

L = 10
dx = 1

hp = 0.01
Ta = 20
T0 = 200

n = int(L/dx)+1

A = np.zeros((n,n))
b = np.zeros(n)

# left BC
A[0,0] = 1
b[0] = T0

# interior nodes
for i in range(1,n-1):

    A[i,i-1] = 1
    A[i,i] = -(2 + hp*dx**2)
    A[i,i+1] = 1

    b[i] = -hp*dx**2*Ta

# insulated tip
A[-1,-1] = 1
A[-1,-2] = -1

T = np.linalg.solve(A,b)

x = np.linspace(0,L,n)

plt.plot(x,T)
plt.grid()
plt.xlabel('Distance (m)')
plt.ylabel('Temperature (C)')
plt.show()